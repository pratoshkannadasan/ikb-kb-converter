# Document Conversion Pipeline - .gitignore

# ==============================================
# SENSITIVE FILES & CREDENTIALS
# ==============================================

# Environment variables (contains OpenAI API key)
.env
.env.local
.env.production
.env.staging
.env.development

# API keys and secrets
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json

# Configuration files with sensitive data
config_local.py
local_settings.py

# ==============================================
# PYTHON FILES
# ==============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ==============================================
# PROJECT-SPECIFIC FILES
# ==============================================

# Log files and directories
logs/
*.log
*.log.*
log_*.txt

# Temporary processing files
temp/
tmp/
*.tmp
*.temp

# Backup files
*.bak
*.backup
*~
*.swp
*.swo

# Test output files
test_output/
test_results/

# Cache directories
.cache/
cache/

# Documentation files
documentation.md
IKB_Doc-Framework_v1.md
IKB_Doc-Framework_v2.md
flowchart.md
CLAUDE.md

# ==============================================
# DOCUMENT FILES (SENSITIVE CONTENT)
# ==============================================

# Original Word documents (may contain sensitive business information)
docs/*.docx
docs/*.doc
docs/*.pdf
docs/*.txt

# Converted output documents (processed sensitive content)
converted_docs/*.md
converted_docs/*.txt
converted_docs/*.pdf
converted_docs/*.docx
converted_docs/docx/*.docx
converted_docs/markdown/*.md
ccnverted_docs/test/*.docx

# Any document backups
docs_backup/
document_archive/

# ==============================================
# DEVELOPMENT TOOLS
# ==============================================

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.atom/
.brackets.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# PyCharm
.idea/
*.iws
*.iml
*.ipr

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ==============================================
# OPERATING SYSTEM FILES
# ==============================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ==============================================
# CLOUD & DEPLOYMENT
# ==============================================

# Docker
.dockerignore
Dockerfile.dev
docker-compose.override.yml

# Kubernetes
*.yaml.local
*.yml.local

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# ==============================================
# DATABASE & DATA FILES
# ==============================================

# SQLite databases
*.sqlite
*.sqlite3
*.db

# Data files
*.csv
*.xlsx
*.json (except config templates)
*.pkl
*.pickle

# ==============================================
# MISC
# ==============================================

# Node.js (if used for any tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archive files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Large files
*.bin
*.exe (except required executables)

# ==============================================
# ALLOW SPECIFIC FILES
# ==============================================

# Keep template and example files
!.env.example
!config_template.py
!IKB_Document_Template.md
!requirements.txt
!README.md

# Keep empty directories with .gitkeep
!**/.gitkeep
